{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./frontend/src/*"]
    }
  },
  "include": ["server", "frontend/src", "vite.config.ts"]
}
