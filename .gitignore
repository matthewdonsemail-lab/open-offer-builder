# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Local env (secrets — TWENTY_API_KEY, JWT secrets live here)
# NOTE: bare .env is also ignored; only .env.example is committed.
.env
.env.local
.env.*.local
!.env.example

# Vite cache
**/.vite/

# Generated from vite.config.ts by tsc
frontend/vite.config.js
frontend/vite.config.d.ts

# Lefthook personal overrides (per-machine hook tweaks, never shared)
.lefthook-local.yml

# Client logos — operator-supplied brand art, served from R2 after upload
# via the editor or ui-kit/apps/web/scripts/upload-offer-logos.ts.
# Never commit; the live URLs live on agencyOffers.mediaLogos in Twenty.
logos/

# Logs / coverage
*.log
coverage/

# Railcode dev-local state (regenerated by `railcode dev`)
railcode/offer-builder/.dev.vars
railcode/offer-builder/.railcode

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

.vercel
.env*
